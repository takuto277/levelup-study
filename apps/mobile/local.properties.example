# Copy this file to `local.properties` in the same directory (Gradle reads it).
# `local.properties` is gitignored — do not commit machine-specific paths.

# Android SDK (required for Gradle). Typical macOS path:
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# Optional: same JDK as Android Studio (avoids "wrong Java" Gradle issues)
# org.gradle.java.home=/Applications/Android Studio.app/Contents/jbr/Contents/Home

# HTTP クライアントが付与する X-API-Key（`shared` の generateLevelupClientApiKey が読む）。
# 値は backend/.env および Render の `API_KEY` と同じ文字列にすること。
# 推奨キー名: api.key（互換のため `API_KEY` でも可）。値の先頭末尾の空白と外側の " 引用符はビルド時に除去される。
# 環境変数 `LEVELUP_API_KEY` が設定されていると local.properties より優先される（古い値が残っていると不一致の原因）。
# api.key=your-secret-here

# 任意: 本番 API で DEBUG + シード userId を試すときの Bearer（Supabase ログインが無い場合のフォールバック）。
# 値は `cd backend && make mint-dev-jwt`（.env の JWT_SECRET を使用）で生成し、1 行をそのまま貼る。Bearer プレフィックスは不要。
# dev.jwt=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 任意: stg 環境切替時に使用する Bearer（stg 用 JWT）。
# 値は stg サーバーの JWT_SECRET で署名された JWT を 1 行で貼る。Bearer プレフィックスは不要。
# 優先: 環境変数 `LEVELUP_STG_DEV_JWT`、なければ local.properties の `stg.dev.jwt`。
# stg.dev.jwt=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 任意: Guest Session（Supabase Anonymous Sign-In）用。
# `SessionMode.GUEST` 選択時や Release ビルドで使用。未設定の場合、Guest モードは実行時エラーになる。
# 優先: 環境変数 `LEVELUP_SUPABASE_URL` / `LEVELUP_SUPABASE_ANON_KEY`、
# なければ local.properties の `supabase.url` / `supabase.anon.key`。
# これらは dev / デフォルト環境用。stg 環境では下記を設定すること。
# supabase.url=https://xxxxxxxx.supabase.co
# supabase.anon.key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 任意: stg 環境切替時の Guest Session（Supabase Anonymous Sign-In）用。
# stg 環境では本番とは別の Supabase プロジェクトを使うことを推奨。
# 優先: 環境変数 `LEVELUP_STG_SUPABASE_URL` / `LEVELUP_STG_SUPABASE_ANON_KEY`、
# なければ local.properties の `stg.supabase.url` / `stg.supabase.anon.key`。
# 未設定の場合、stg 環境で Guest モードを選ぶと実行時エラーになる。
# stg.supabase.url=https://yyyyyyyy.supabase.co
# stg.supabase.anon.key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
